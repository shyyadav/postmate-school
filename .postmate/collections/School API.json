      "testScript": "const response = RESPONSE.body;\nconst status = RESPONSE.status;\nconst headers = RESPONSE.headers;\n\npm.test(\"Returns HTTP 200\", function () {\n  pm.expect(status).to.eql(200);\n});\n\npm.test(\"Returns JSON\", function () {\n  pm.expect(headers[\"content-type\"]).to.include(\"application/json\");\n});\n\npm.schemaTest(\"Validates client response schema\", {\n  type: \"object\",\n  required: [\"fullName\", \"email\", \"userType\", \"isEmailConfirmed\", \"school\"],\n  properties: {\n    fullName: { type: \"string\" },\n    email: { type: \"string\" },\n    userType: { type: \"string\" },\n    isEmailConfirmed: { type: \"boolean\" },\n    school: {\n      type: \"object\",\n      required: [\"schoolName\", \"isAutoInvoice\", \"invoiceDate\", \"grades\"],\n      properties: {\n        schoolName: { type: \"string\" },\n        isAutoInvoice: { type: \"boolean\" },\n        invoiceDate: { type: \"number\" },\n        grades: {\n          type: \"array\",\n          items: { type: \"string\" }\n        }\n      }\n    }\n  }\n}, response);\n\npm.test(\"Validates client identity\", function () {\n  pm.expect(response.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/);\n  pm.expect(response.fullName.trim()).to.not.eql(\"\");\n});",
