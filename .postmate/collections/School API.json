      "testScript": "const response = RESPONSE.body;\n\npm.test(\"Status code is 200\", () => {\n  pm.expect(RESPONSE.status).to.eql(200);\n});\n\npm.test(\"Response is JSON\", () => {\n  const contentType =\n    RESPONSE.headers[\"content-type\"] || RESPONSE.headers[\"Content-Type\"];\n\n  pm.expect(contentType).to.include(\"application/json\");\n});\n\npm.schemaTest(\"Validate students response schema\", {\n  type: \"object\",\n  required: [\"userProfile\", \"schoolInof\", \"students\"],\n  properties: {\n    userProfile: {\n      type: \"object\",\n      required: [\"fullName\"],\n      properties: {\n        fullName: { type: \"string\" }\n      }\n    },\n    schoolInof: {\n      type: \"object\",\n      required: [\"schoolName\", \"isAutoInvoice\", \"invoiceDate\"],\n      properties: {\n        schoolName: { type: \"string\" },\n        isAutoInvoice: { type: \"boolean\" },\n        invoiceDate: { type: \"number\" },\n        grades: { type: [\"array\", \"null\"] }\n      }\n    },\n    students: {\n      type: \"array\",\n      items: {\n        type: \"object\",\n        required: [\n          \"studentId\",\n          \"name\",\n          \"grade\",\n          \"status\",\n          \"paymentStatus\"\n        ],\n        properties: {\n          studentId: { type: \"number\" },\n          name: { type: \"string\" },\n          grade: { type: \"string\" },\n          status: { type: \"string\" },\n          paymentStatus: { type: \"string\" },\n          school: { type: [\"object\", \"null\"] }\n        }\n      }\n    }\n  }\n}, response);\n\npm.test(\"Validate student data\", () => {\n  pm.expect(response.userProfile.fullName).to.eql(\"Shyam Narayan Yadav\");\n  pm.expect(response.schoolInof.schoolName.trim()).to.eql(\"ABC Learning Academy\");\n  pm.expect(response.students).to.be.an(\"array\");\n});",
